# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Models are set in app/config.py (MODEL_FAST, MODEL_SMART). Override here only if needed.
# MODEL_FAST=gpt-5.6-luna
# MODEL_SMART=gpt-5.6-sol
# Optional reasoning effort: low | medium | high. Empty = model default.
REASONING_FAST=
REASONING_SMART=

# Spending cap for one running app, in USD. After it: answers from the demo cache.
BUDGET_USD=5
# National Bank rate for the day (tenge per 1 USD). 0 = show only USD.
USD_KZT=0
# auto | on | off
DEMO_MODE=auto
APP_TITLE=Fintech AI Agent
RATE_LIMIT_PER_MIN=20
